{
  "mcpServers": {
    "tether-reader": {
      "command": "node",
      "args": [
        "src/reader-server/index.js"
      ]
    },
    "tether-map": {
      "command": "node",
      "args": [
        "src/app-map/server.js"
      ]
    },
    "chrome-devtools": {
      "command": "node",
      "args": [
        "node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--auto-connect"
      ]
    }
  }
}
