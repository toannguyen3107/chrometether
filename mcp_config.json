{
  "mcpServers": {
    "tether-reader": {
      "command": "node",
      "args": [
        "src/reader-server/index.js"
      ]
    },
    "tether-map": {
      "command": "node",
      "args": [
        "src/app-map/server.js"
      ]
    },
    "chrome_devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--auto-connect"
      ]
    }
  }
}
